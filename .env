# HOMER
HOMER_PORT=8081

# JENKINS
JENKINS_PORT=8082
# JENKINS_AGENT_PORT=50000
JENKINS_URL=/jenkins
JENKINS_OPTS="--prefix=/jenkins"

# Required Jenkins local users. Set real values before starting Jenkins.
JENKINS_ADMIN_USER=abir
JENKINS_ADMIN_PASSWORD=admin123
JENKINS_DEV_USER=dev
JENKINS_DEV_PASSWORD=dev123

# Optional Slack settings.
SLACK_TEAM_DOMAIN=my-workspace
SLACK_DEFAULT_CHANNEL=#jenkins

# POSTGRES
POSTGRES_PORT=5432

#Docker
DOCKER_USER="abirall"